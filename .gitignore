# ─── Dependencies ────────────────────────────
node_modules/

# ─── Next.js build output ────────────────────
.next/
out/

# ─── Secrets — NEVER commit these ───────────
.env
.env.local
.env.production.local
.env.development.local

# Hand-made backups of env files (.env.bak, .env.local.bak.<lan-ip>, …) — same secrets,
# not covered by the rules above.
.env*.bak*
*.env.bak*

# ─── IDE files ───────────────────────────────
.idea/
.vscode/
*.iml

# ─── OS files ────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo
